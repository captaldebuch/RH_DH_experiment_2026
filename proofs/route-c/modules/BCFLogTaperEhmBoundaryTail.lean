import RiemannHypothesis.Criteria.NymanBeurling.BCFLogTaperEhmCompensator
import Mathlib.NumberTheory.ArithmeticFunction.VonMangoldt

/-!
# Boundary-tail form of the finite Ehm log taper

This module proves the summation algebra which converts a finite logarithmic
taper into an infinite-transform main term and two translated tails.  The
actual Ehm series identities and their summability assumptions remain
explicit inputs; no decay of either tail is asserted.
-/

namespace RH.Criteria.NymanBeurling.BCFLogTaperEhmBoundaryTail

open scoped BigOperators Topology ArithmeticFunction
open RH.Criteria.NymanBeurling.BCFLogTaper

/-- The Möbius-weighted `S₁` summand at scale `x`. -/
noncomputable def ehmMobiusS1Term (S1 : ℝ → ℝ) (x : ℝ) (n : ℕ) : ℝ :=
  ((ArithmeticFunction.moebius n : ℤ) : ℝ) * S1 ((n : ℝ) * x)

/-- Its logarithmically weighted companion. -/
noncomputable def ehmMobiusLogS1Term
    (S1 : ℝ → ℝ) (x : ℝ) (n : ℕ) : ℝ :=
  ehmMobiusS1Term S1 x n * Real.log (n : ℝ)

/-- The von Mangoldt--`R₁` summand in the logarithmic Möbius transform. -/
noncomputable def ehmVonMangoldtR1Term
    (R1 : ℝ → ℝ) (x : ℝ) (n : ℕ) : ℝ :=
  ArithmeticFunction.vonMangoldt n * R1 ((n : ℝ) * x)

/-- The exact von Mangoldt--`R₁` transform; its summability is kept as an
explicit field of `EhmBoundaryTailSeriesPackage`. -/
noncomputable def ehmVonMangoldtR1Transform
    (R1 : ℝ → ℝ) (x : ℝ) : ℝ :=
  ∑' n : ℕ, ehmVonMangoldtR1Term R1 x n

@[simp] theorem ehmMobiusS1Term_zero (S1 : ℝ → ℝ) (x : ℝ) :
    ehmMobiusS1Term S1 x 0 = 0 := by
  simp [ehmMobiusS1Term]

@[simp] theorem ehmMobiusLogS1Term_zero (S1 : ℝ → ℝ) (x : ℝ) :
    ehmMobiusLogS1Term S1 x 0 = 0 := by
  simp [ehmMobiusLogS1Term]

private theorem sum_range_succ_eq_sum_Icc_one_of_zero
    (a : ℕ → ℝ) (ha0 : a 0 = 0) (N : ℕ) :
    (∑ n ∈ Finset.range (N + 1), a n) =
      ∑ n ∈ Finset.Icc 1 N, a n := by
  induction N with
  | zero => simp [ha0]
  | succ N ih =>
      rw [Finset.sum_range_succ, ih]
      rw [Finset.sum_Icc_succ_top (by omega)]

/-- Generic exact log-taper identity.  `B` is the negative of the total
log-weighted transform.  The right side retains both translated tails and
does not estimate them separately. -/
theorem finiteLogTaper_sub_total_eq_boundaryTails
    (a b : ℕ → ℝ) (N : ℕ)
    (ha : Summable a) (hb : Summable b)
    (ha0 : a 0 = 0) (hb0 : b 0 = 0)
    (B : ℝ) (hB : ∑' n : ℕ, b n = -B) :
    (∑ n ∈ Finset.Icc 1 N,
        (a n - b n / Real.log (N : ℝ))) - (∑' n : ℕ, a n) =
      B / Real.log (N : ℝ) +
        (∑' j : ℕ, b (j + (N + 1))) / Real.log (N : ℝ) -
          ∑' j : ℕ, a (j + (N + 1)) := by
  have haSplit := ha.sum_add_tsum_nat_add (N + 1)
  have hbSplit := hb.sum_add_tsum_nat_add (N + 1)
  rw [Finset.sum_sub_distrib, ← Finset.sum_div,
    ← sum_range_succ_eq_sum_Icc_one_of_zero a ha0 N,
    ← sum_range_succ_eq_sum_Icc_one_of_zero b hb0 N]
  rw [show (∑ n ∈ Finset.range (N + 1), a n) =
      (∑' n : ℕ, a n) - ∑' j : ℕ, a (j + (N + 1)) by linarith]
  rw [show (∑ n ∈ Finset.range (N + 1), b n) =
      (∑' n : ℕ, b n) - ∑' j : ℕ, b (j + (N + 1)) by linarith]
  rw [hB]
  ring

/-- The existing BCF coefficients are exactly the finite log taper of the
Möbius--`S₁` and Möbius-log--`S₁` sequences. -/
theorem ehmFiniteInnerSum_eq_logTaperTerms
    (S1 : ℝ → ℝ) (x : ℝ) (N : ℕ) (hN : 2 ≤ N) :
    (∑ n ∈ Finset.Icc 1 N,
      dirichletCoeff N n * S1 ((n : ℝ) * x)) =
      ∑ n ∈ Finset.Icc 1 N,
        (ehmMobiusS1Term S1 x n -
          ehmMobiusLogS1Term S1 x n / Real.log (N : ℝ)) := by
  apply Finset.sum_congr rfl
  intro n _
  rw [dirichletCoeff, weight_of_two_le hN]
  unfold ehmMobiusLogS1Term ehmMobiusS1Term
  ring

/-- The incomplete divisor coefficient generated by the BCF log taper. -/
noncomputable def ehmLogTaperDivisorCoeff (N j : ℕ) : ℝ :=
  ∑ d ∈ j.divisors,
    if d ≤ N then dirichletCoeff N d else 0

/-- The initial incomplete divisor coefficient is `1`. -/
theorem ehmLogTaperDivisorCoeff_one (N : ℕ) (hN : 2 ≤ N) :
    ehmLogTaperDivisorCoeff N 1 = 1 := by
  have hN0 : N ≠ 0 := by omega
  simp [ehmLogTaperDivisorCoeff, dirichletCoeff, weight_of_two_le hN, hN0]

/-- Below the cutoff, every divisor is retained. -/
theorem ehmLogTaperDivisorCoeff_eq_fullDivisorSum
    (N j : ℕ) (hjpos : 0 < j) (hjN : j ≤ N) :
    ehmLogTaperDivisorCoeff N j =
      ∑ d ∈ j.divisors, dirichletCoeff N d := by
  unfold ehmLogTaperDivisorCoeff
  apply Finset.sum_congr rfl
  intro d hd
  have hdj : d ∣ j := Nat.dvd_of_mem_divisors hd
  have hdN : d ≤ N := (Nat.le_of_dvd hjpos hdj).trans hjN
  simp [hdN]

/-- The Möbius divisor sum vanishes away from `j = 1`. -/
private theorem sum_moebius_divisors_eq_zero
    (j : ℕ) (hj : 1 < j) :
    (∑ d ∈ j.divisors,
      ((ArithmeticFunction.moebius d : ℤ) : ℝ)) = 0 := by
  calc
    (∑ d ∈ j.divisors,
        ((ArithmeticFunction.moebius d : ℤ) : ℝ)) =
        (((ArithmeticFunction.moebius : ArithmeticFunction ℤ) :
            ArithmeticFunction ℝ) *
          (ArithmeticFunction.zeta : ArithmeticFunction ℝ)) j :=
      (ArithmeticFunction.coe_mul_zeta_apply
        (f := ((ArithmeticFunction.moebius : ArithmeticFunction ℤ) :
          ArithmeticFunction ℝ))).symm
    _ = (1 : ArithmeticFunction ℝ) j := by
      rw [ArithmeticFunction.coe_moebius_mul_coe_zeta]
    _ = 0 := by simp [hj.ne']

/-- For `2 ≤ j ≤ N`, the incomplete divisor coefficient is exactly the
finite von Mangoldt boundary term `Λ(j) / log N`. -/
theorem ehmLogTaperDivisorCoeff_eq_vonMangoldt_div_log
    (N j : ℕ) (hN : 2 ≤ N) (hj : 2 ≤ j) (hjN : j ≤ N) :
    ehmLogTaperDivisorCoeff N j =
      ArithmeticFunction.vonMangoldt j / Real.log (N : ℝ) := by
  rw [ehmLogTaperDivisorCoeff_eq_fullDivisorSum N j (by omega) hjN]
  unfold dirichletCoeff
  simp_rw [weight_of_two_le hN]
  have hmu := sum_moebius_divisors_eq_zero j (by omega)
  have hmulog := ArithmeticFunction.sum_moebius_mul_log_eq (n := j)
  have hmulog' :
      (∑ d ∈ j.divisors,
        ((ArithmeticFunction.moebius d : ℤ) : ℝ) *
          Real.log (d : ℝ)) = -ArithmeticFunction.vonMangoldt j := by
    simpa only [ArithmeticFunction.log_apply] using hmulog
  calc
    (∑ d ∈ j.divisors,
        ((ArithmeticFunction.moebius d : ℤ) : ℝ) *
          (1 - Real.log (d : ℝ) / Real.log (N : ℝ))) =
        (∑ d ∈ j.divisors,
          ((ArithmeticFunction.moebius d : ℤ) : ℝ)) -
          (∑ d ∈ j.divisors,
            ((ArithmeticFunction.moebius d : ℤ) : ℝ) *
              Real.log (d : ℝ)) / Real.log (N : ℝ) := by
      rw [Finset.sum_div, ← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro d _
      ring
    _ = _ := by rw [hmu, hmulog']; ring

/-- Honest analytic inputs for the boundary-tail reduction.  The first two
fields are convergence assumptions; the last two are the Ehm Möbius-inversion
and logarithmic-transform identities. -/
structure EhmBoundaryTailSeriesPackage
    (S1 : ℝ → ℝ) (R1 : ℝ → ℝ) where
  mobius_summable : ∀ x : ℝ, 0 < x → Summable (ehmMobiusS1Term S1 x)
  mobiusLog_summable : ∀ x : ℝ, 0 < x →
    Summable (ehmMobiusLogS1Term S1 x)
  vonMangoldt_summable : ∀ x : ℝ, 0 < x →
    Summable (ehmVonMangoldtR1Term R1 x)
  mobius_inversion : ∀ x : ℝ, 0 < x →
    ∑' n : ℕ, ehmMobiusS1Term S1 x n = R1 x
  log_transform : ∀ x : ℝ, 0 < x →
    ∑' n : ℕ, ehmMobiusLogS1Term S1 x n =
      -ehmVonMangoldtR1Transform R1 x

/-- Exact finite Ehm boundary-tail decomposition.  This is the non-asymptotic
identity suggested by infinite Möbius inversion: the remaining research
problem is to control the signed combination on the right after the outer
`m`-sum, not to bound its two tails absolutely. -/
theorem ehmFiniteLogTaper_sub_R1_eq_boundaryTails
    {S1 R1 : ℝ → ℝ}
    (H : EhmBoundaryTailSeriesPackage S1 R1)
    (x : ℝ) (hx : 0 < x) (N : ℕ) (hN : 2 ≤ N) :
    (∑ n ∈ Finset.Icc 1 N,
        dirichletCoeff N n * S1 ((n : ℝ) * x)) - R1 x =
      ehmVonMangoldtR1Transform R1 x / Real.log (N : ℝ) +
        (∑' j : ℕ, ehmMobiusLogS1Term S1 x (j + (N + 1))) /
            Real.log (N : ℝ) -
          ∑' j : ℕ, ehmMobiusS1Term S1 x (j + (N + 1)) := by
  rw [ehmFiniteInnerSum_eq_logTaperTerms S1 x N hN,
    ← H.mobius_inversion x hx]
  exact finiteLogTaper_sub_total_eq_boundaryTails
    (ehmMobiusS1Term S1 x) (ehmMobiusLogS1Term S1 x) N
    (H.mobius_summable x hx) (H.mobiusLog_summable x hx)
    (ehmMobiusS1Term_zero S1 x) (ehmMobiusLogS1Term_zero S1 x)
    (ehmVonMangoldtR1Transform R1 x) (H.log_transform x hx)

/-- H15 specialization of the boundary-tail identity at `x = 1/m`. -/
theorem ehmFiniteLogTaper_reciprocal_sub_R1_eq_boundaryTails
    {S1 R1 : ℝ → ℝ}
    (H : EhmBoundaryTailSeriesPackage S1 R1)
    (m N : ℕ) (hm : 0 < m) (hN : 2 ≤ N) :
    (∑ n ∈ Finset.Icc 1 N,
        dirichletCoeff N n * S1 ((n : ℝ) / (m : ℝ))) -
          R1 (1 / (m : ℝ)) =
      ehmVonMangoldtR1Transform R1 (1 / (m : ℝ)) /
          Real.log (N : ℝ) +
        (∑' j : ℕ, ehmMobiusLogS1Term S1 (1 / (m : ℝ))
            (j + (N + 1))) / Real.log (N : ℝ) -
          ∑' j : ℕ, ehmMobiusS1Term S1 (1 / (m : ℝ))
            (j + (N + 1)) := by
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  simpa [div_eq_mul_inv] using
    ehmFiniteLogTaper_sub_R1_eq_boundaryTails H
      (1 / (m : ℝ)) (one_div_pos.mpr hmR) N hN

end RH.Criteria.NymanBeurling.BCFLogTaperEhmBoundaryTail
