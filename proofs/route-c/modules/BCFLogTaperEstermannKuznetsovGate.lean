import RiemannHypothesis.Criteria.NymanBeurling.BCFLogTaperEstermannFiniteFourier
import RiemannHypothesis.Criteria.NymanBeurling.BCFLogTaperEstermannKernelExtraction

/-!
# Route B8: the exact signed Estermann/Kuznetsov closure gate

This module isolates, without asserting, the single result which remains after
the proved Estermann continuation, functional equation, inverse-frequency
normalization, special value, Laurent coefficients, and finite contour
geometry:

1. the signed, correction-coupled automorphic estimate for the complete H15
   expression.

This field is the RH-strength input.  A standard unsigned Kuznetsov
bound is not enough: its estimate must retain the logarithmic taper, both
orientations, the linear correction, and the constant in the same signed
expression.

The rational harmonic sine endpoint is no longer a field: it is proved in
`BCFLogTaperRationalSineEndpoint` by a finite Dirichlet-kernel calculation
followed by the Dirichlet--Abelian boundary theorem.

The inverse-residue Bernoulli/cotangent identity is likewise no longer a
field: `BCFLogTaperEstermannFiniteFourier` proves it by finite DFT inversion.
-/

namespace RH.Criteria.NymanBeurling.BCFLogTaperEstermannKuznetsovGate

open RH.Criteria.NymanBeurling.BaezDuarte
open RH.Criteria.NymanBeurling.BCFLogTaperEstermannAtZeroBridge
open RH.Criteria.NymanBeurling.BCFLogTaperEstermannAtZeroReduction
open RH.Criteria.NymanBeurling.BCFLogTaperRationalSineEndpoint
open RH.Criteria.NymanBeurling.BCFLogTaperEstermannFiniteFourier
open RH.Criteria.NymanBeurling.BCFLogTaperSpectral

/-- The Hurwitz endpoint package generated by the rational sine-series
formula. -/
noncomputable def hurwitzZeroFormulaOfRationalSine
    (H : RationalSineZetaOneFormula) : HurwitzZetaZeroFormula :=
  (hurwitzZetaZeroNonzeroFormula_of_rationalSineZetaOne H).toZeroFormula

/-- The complete Hurwitz endpoint generated from the ordered harmonic sine
series, using the proved Dirichlet--Abelian analytic compatibility layer. -/
noncomputable def hurwitzZeroFormulaOfHarmonicSine
    (H : RationalSineHarmonicSeriesFormula) : HurwitzZetaZeroFormula :=
  hurwitzZeroFormulaOfRationalSine
    (rationalSineZetaOneFormula_of_harmonicSeries H)

/-- The unconditional rational Hurwitz-zeta value at zero. -/
noncomputable def rationalHurwitzZeroFormula : HurwitzZetaZeroFormula :=
  hurwitzZeroFormulaOfRationalSine rationalSineZetaOneFormula

/-- The unconditional analytic Estermann value at zero in the Vasyunin
normalization. -/
noncomputable def rationalAnalyticEstermannAtZeroPackage :
    EstermannAtZeroPackage :=
  analyticEstermannAtZeroPackage rationalHurwitzZeroFormula
    estermannBernoulliCotangentIdentity

/-- The complete, explicitly dependent Route-B closure data.  No instance is
declared in this file. -/
structure SignedEstermannKuznetsovGate where
  cancellation : EstermannCoupledCancellationEstimate
    rationalAnalyticEstermannAtZeroPackage

/-- A genuine inhabitant of the signed gate gives spectral vanishing. -/
noncomputable def SignedEstermannKuznetsovGate.toSpectralVanishing
    (H : SignedEstermannKuznetsovGate) : SpectralVanishingEstimate :=
  spectralVanishingEstimate_of_analyticEstermannCancellation
    rationalHurwitzZeroFormula estermannBernoulliCotangentIdentity
      H.cancellation

/-- A genuine inhabitant of the signed gate closes the Báez--Duarte
criterion. -/
theorem baezDuarteCriterion_of_signedEstermannKuznetsov
    (H : SignedEstermannKuznetsovGate) : BaezDuarteCriterion :=
  baezDuarteCriterion_of_analyticEstermannCancellation
    rationalHurwitzZeroFormula estermannBernoulliCotangentIdentity
      H.cancellation

end RH.Criteria.NymanBeurling.BCFLogTaperEstermannKuznetsovGate
