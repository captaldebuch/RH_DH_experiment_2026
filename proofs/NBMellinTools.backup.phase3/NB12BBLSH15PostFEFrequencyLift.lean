import NBMellinTools.NB12BBLSH15PostFEFrequencyCollisionGram

/-!
# NB12zzzV: lifting literal post-FE phases to a common period

The collision Gram template assumes that all phase frequencies live in one
`ZMod M`.  Literal H15 atoms initially have different denominators.  This
file supplies the exact arithmetic bridge:

* a character of denominator `q` lifts to any positive multiple `M` by
  multiplying its numerator by `M / q`;
* every common-pair H15 phase is one character with an explicit base
  frequency modulo `q*q'`; and
* every retained doubled missing-residue phase has base frequency `2*u`
  modulo `q`.

These are finite equalities, not estimates.  The next layer may therefore
choose a common superperiod and instantiate the collision ledger without
changing any phase or coefficient.
-/

open AddChar Complex ZMod
open scoped BigOperators ComplexConjugate

namespace NBMellinTools.NB12

/-! ## Generic denominator lift -/

/-- Multiplying both the numerator and denominator by the same positive
natural number leaves the additive phase unchanged. -/
theorem stdAddChar_nat_lift_mul
    (q b a r : ℕ) (hq : 0 < q) (hb : 0 < b) :
    letI : NeZero q := ⟨hq.ne'⟩
    letI : NeZero (q * b) := ⟨Nat.mul_ne_zero hq.ne' hb.ne'⟩
    ZMod.stdAddChar (((a * r : ℕ) : ZMod q)) =
      ZMod.stdAddChar (((a * r * b : ℕ) : ZMod (q * b))) := by
  letI : NeZero q := ⟨hq.ne'⟩
  letI : NeZero (q * b) := ⟨Nat.mul_ne_zero hq.ne' hb.ne'⟩
  rw [show ZMod.stdAddChar (((a * r : ℕ) : ZMod q)) =
      Complex.exp
        (2 * (Real.pi : ℂ) * Complex.I * ((a * r : ℕ) : ℂ) /
          (q : ℂ)) by
    simpa using ZMod.stdAddChar_coe (N := q) ((a * r : ℕ) : ℤ)]
  rw [show ZMod.stdAddChar (((a * r * b : ℕ) : ZMod (q * b))) =
      Complex.exp
        (2 * (Real.pi : ℂ) * Complex.I *
          ((a * r * b : ℕ) : ℂ) / ((q * b : ℕ) : ℂ)) by
    simpa using ZMod.stdAddChar_coe (N := q * b)
      ((a * r * b : ℕ) : ℤ)]
  congr 1
  have hqC : (q : ℂ) ≠ 0 := by exact_mod_cast hq.ne'
  have hbC : (b : ℂ) ≠ 0 := by exact_mod_cast hb.ne'
  push_cast
  field_simp [hqC, hbC]

/-! ## Literal H15 base frequencies -/

noncomputable def h15PostFECommonPairBaseFrequency
    (left right : BettinChandeeUnitSign)
    (u q v q' : ℕ) [NeZero (q * q')] : ZMod (q * q') :=
  -h15PostFESignedCommonResidue left
      (((u * q' : ℕ) : ZMod (q * q'))) +
    h15PostFESignedCommonResidue right
      (((v * q : ℕ) : ZMod (q * q')))

/-- On a genuine reduced pair, the literal common phase is the character
generated by its base frequency. -/
theorem h15PostFECommonPairAdditivePhase_eq_baseFrequency
    (left right : BettinChandeeUnitSign)
    (r u q v q' : ℕ) (hq : 0 < q) (hq' : 0 < q')
    (huq : Nat.Coprime u q) (hvq' : Nat.Coprime v q') :
    letI : NeZero (q * q') :=
      ⟨Nat.mul_ne_zero hq.ne' hq'.ne'⟩
    h15PostFECommonPairAdditivePhase left right r u q v q' =
      ZMod.stdAddChar
        ((r : ZMod (q * q')) *
          h15PostFECommonPairBaseFrequency left right u q v q') := by
  letI : NeZero (q * q') :=
    ⟨Nat.mul_ne_zero hq.ne' hq'.ne'⟩
  unfold h15PostFECommonPairAdditivePhase
    h15PostFECommonPairBaseFrequency
  simp only [Nat.mul_ne_zero hq.ne' hq'.ne', dite_false]
  rw [if_pos ⟨huq, hvq'⟩]
  cases left <;> cases right <;>
    simp only [h15PostFESignedCommonResidue] <;>
    congr 2 <;> push_cast <;> ring

noncomputable def h15PostFEMissingBaseFrequency
    (u q : ℕ) [NeZero q] : ZMod q :=
  ((2 * u : ℕ) : ZMod q)

/-- On a reduced missing-residue row, the retained doubled phase is the
character generated by `2*u`. -/
theorem h15PostFEReducedDoubledAdditivePhase_eq_baseFrequency
    (r u q : ℕ) (hq : 0 < q) (huq : Nat.Coprime u q) :
    letI : NeZero q := ⟨hq.ne'⟩
    h15PostFEReducedDoubledAdditivePhase r u q =
      ZMod.stdAddChar
        ((r : ZMod q) * h15PostFEMissingBaseFrequency u q) := by
  letI : NeZero q := ⟨hq.ne'⟩
  unfold h15PostFEReducedDoubledAdditivePhase
    h15PostFEMissingBaseFrequency
  simp only [hq.ne', dite_false]
  rw [if_pos huq]
  congr 2
  push_cast
  ring

end NBMellinTools.NB12
