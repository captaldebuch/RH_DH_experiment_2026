# Keep research artifacts out of textual diffs.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary

# Large knowledge graphs are data artifacts; retain their contents but avoid
# expensive line-oriented diffs in web and command-line review.
*.jsonld -diff

# Normalize source and documentation line endings.
*.lean text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
